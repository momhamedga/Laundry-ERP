# ======================================
# Laundry ERP - API Environment Variables
# ======================================

# Server
NODE_ENV=development
PORT=4000

# Database (Neon PostgreSQL)
# احصل على الرابط من: https://console.neon.tech
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# CORS - origins مفصولة بفواصل
CORS_ORIGINS=http://localhost:3000

# JWT - ولّد أسراراً قوية:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS________________
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS________________

# Token TTL
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# Email (Forgot Password) - Resend هو المزود الافتراضي
# احصل على مفتاح من: https://resend.com/api-keys
# اختياري: بغيابه لا يُسقط الخادم، لكن /auth/forgot-password لن يُرسل بريداً فعلياً
RESEND_API_KEY=
# لازم يكون Domain مُتحقَّق منه على Resend لإرسال حقيقي بالإنتاج
EMAIL_FROM="Laundry ERP <no-reply@laundry-erp.local>"
# يُستخدم لبناء رابط إعادة تعيين كلمة المرور: ${FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:3000
