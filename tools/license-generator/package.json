{
  "name": "@laundry/license-generator",
  "version": "1.0.0",
  "private": true,
  "description": "DEVELOPER-ONLY offline license generator. Never ship to customers.",
  "main": "dist/cli.js",
  "bin": { "laundry-license": "dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
